# Copy to .env to customise `docker compose up`. No secrets are needed or used by CertWatch.

# Address the web UI is published on. The default keeps it private to this machine.
# For Tailscale, use this machine's Tailscale address (`tailscale ip -4`), e.g. 100.101.102.103.
# CertWatch has no authentication: NEVER use 0.0.0.0 on a machine reachable from the internet.
CERTWATCH_BIND=127.0.0.1

# Host port for the web UI.
CERTWATCH_PORT=8080
